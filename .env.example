# Backend environment template. These variables are server-only.
# Supply real secrets through your secret manager; do not commit .env.
ASPNETCORE_ENVIRONMENT=Development
Database__Provider=SqlServer
ConnectionStrings__DefaultConnection=
# Generate with: openssl rand -base64 48
Jwt__Key=
Jwt__Issuer=learnfy
Jwt__Audience=learnfy-clients
Jwt__ExpiryMinutes=15
# Optional Resend delivery. Missing config is reported as 503, never fake mail.
Email__ApiKey=
Email__From=
Email__PublicWebUrl=
# Required persistent, access-restricted volume for production encrypted mail.
DataProtection__KeyDirectory=
